# RouteDesk Environment Configuration

# Database: SQLite for local dev/testing, PostgreSQL in production
DATABASE_URL=sqlite:///./local_db/app.db
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/routedesk?sslmode=require

# Authentication & Security
JWT_SECRET=routedesk-insecure-secret-key-change-in-production-min32chars
SERVICE_TOKEN=dev-service-token-secret-for-github-actions
DEMO_MODE=true

# Model & Serving
MODEL_DIR=./artifacts/bundle
CHAMPION_POINTER=./models/champion.json

# Business & Localization
TZ_BUSINESS=Asia/Kolkata
LOG_LEVEL=INFO

# External Integrations (Optional in dev)
SMTP_URL=smtp://localhost:1025
WEBHOOK_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Hosted MLflow (DagsHub or local)
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
